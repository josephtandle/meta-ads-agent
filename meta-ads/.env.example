# Meta Ads agent settings. Copy this file to .env in the meta-ads folder
# and fill in your own values. Never commit the real .env file.
META_ADS_ACCESS_TOKEN=your_long_lived_token_here
META_ADS_ACCOUNT_ID=act_XXXXXXXXXXXXXXXXX
META_ADS_APP_ID=your_app_id
META_ADS_APP_SECRET=your_app_secret
# Writes stay off until you set this to true. Keep it false for read-only use.
META_ADS_WRITES_ENABLED=false
# Highest daily or lifetime budget the agent may send to Meta, in cents (2000 = $20.00). Applies even when unset.
META_ADS_MAX_DAILY_BUDGET_CENTS=2000
